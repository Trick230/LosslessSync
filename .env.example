# Copy to .env (ignored by git) and fill in. gpu/run_gpu.py and tools/media_sync.py read it;
# the environment wins over it.

# Modal (modal.com > Settings > API tokens; or run `modal token new` once instead)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# LLS_MODAL_GPU=T4

# Kaggle (kaggle.com > Settings > API > Create New Token; or ~/.kaggle/kaggle.json instead)
KAGGLE_USERNAME=
KAGGLE_KEY=

# PC: send the separation to the cloud while the local GPU is busy (~/.lls/gpu.lock)
# LLS_GPU_FALLBACK=cloud
# LONG=1 tries Kaggle before Modal (long jobs)

# Media (tools/media_sync.py). PC: the folders (refs/ + srcs/ inside, or EN/PT in the names)
# LLS_MEDIA_DIR=
# LLS_OUT_DIR=
# Cloud: the rclone remote gdrive:, limited to the Drive folder LosslessSync. Run
# `rclone config` once on the PC (Windows: winget install Rclone.Rclone; new remote "gdrive",
# type drive, scope drive, root_folder_id = the id at the end of the folder's URL), then copy
# the token line of `rclone config show gdrive` here.
# RCLONE_CONFIG_GDRIVE_TYPE=drive
# RCLONE_CONFIG_GDRIVE_SCOPE=drive
# RCLONE_CONFIG_GDRIVE_ROOT_FOLDER_ID=
# RCLONE_CONFIG_GDRIVE_TOKEN={"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}
