# Copy to .env (ignored by git) and fill in. gpu/run_gpu.py and tools/media_sync.py read it;
# the environment wins over it.

# Modal (modal.com > Settings > API tokens; or run `modal token new` once instead)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# LLS_MODAL_GPU=T4

# Kaggle (kaggle.com > Settings > API > Create New Token; or ~/.kaggle/kaggle.json instead)
KAGGLE_USERNAME=
KAGGLE_KEY=

# PC: send the separation to the cloud while the local GPU is busy (~/.lls/gpu.lock)
# LLS_GPU_FALLBACK=cloud
# LONG=1 tries Kaggle before Modal (long jobs)
